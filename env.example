# PayPal Merchant Dispute Copilot — environment template
# Copy to .env.local (rename to .env.example when committing outside this sandbox) and fill in
# the keys you have. All keys are optional for the local demo: without Supabase the app uses an
# in-memory store, without OPENROUTER_API_KEY the copilot returns a rule-based draft, and without
# PayPal creds submit returns a clear error.

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# --- LLM (OpenRouter, OpenAI-compatible endpoint used by @ai-sdk/openai) ---
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY

# --- PayPal Sandbox (Disputes API v1 + Webhooks) ---
# Leave unset (or use a sandbox_mock_* placeholder) for Mock Mode:
# submit then simulates success without calling PayPal.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
